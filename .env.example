# ---------------------------------------------------------------------------
# SitePulse environment template
# Copy to `.dev.vars` for local development (`wrangler dev`), and set the same
# names as Worker secrets in production (`wrangler secret put NAME`).
# NEVER commit a file containing real values.
# ---------------------------------------------------------------------------

# 32+ random bytes, base64. Used for AES-GCM encryption of notification
# channel secrets (webhook signing tokens) at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Optional: password-pepper mixed into PBKDF2 hashes. Changing it later
# invalidates existing passwords, so set it once on a fresh deployment.
AUTH_PEPPER=

# Public base URL of the deployment, used in notification emails.
PUBLIC_BASE_URL=https://sitepulse.example.workers.dev

# --- Email notifications (optional) ---------------------------------------
# SitePulse sends email through any Resend-compatible HTTP endpoint.
# Without a key, email channels are stored but deliveries are recorded as
# "skipped: email provider not configured" instead of silently pretending to send.
EMAIL_API_KEY=
EMAIL_FROM=SitePulse <alerts@example.com>
EMAIL_API_URL=https://api.resend.com/emails

# --- Tunables (override the defaults in wrangler.jsonc) --------------------
PROBES_PER_RUN=20
REQUIRE_EMAIL_VERIFICATION=false
